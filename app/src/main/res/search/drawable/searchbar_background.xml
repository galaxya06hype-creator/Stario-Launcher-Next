<!-- MOD iOS 26 Liquid Glass searchbar - ref: WWDC25 session 219 -->
<!-- Glass.regular dengan blur 24, refraction 10, dispersion 0.4, corner 30dp -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <!-- Liquid Glass translucent base - iOS 26 Material -->
                    <solid android:color="#4DFFFFFF" />
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <!-- iOS 26 highlight shimmer (top edge reflection) -->
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:endColor="@android:color/transparent" android:startColor="#33FFFFFF" android:type="linear" />
                    <corners android:radius="29dp" />
                </shape>
            </item>
            <!-- iOS 26 dispersion tint bottom -->
            <item android:top="30dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#0D000000" android:startColor="@android:color/transparent" android:type="linear"/>
                    <corners android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp" android:topLeftRadius="0dp" android:topRightRadius="0dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <!-- Glass.clear saat tidak focused - lebih transparan -->
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>

</selector>