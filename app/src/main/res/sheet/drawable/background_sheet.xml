<!-- MOD iOS 26 Liquid Glass Sheet - translucent + refraction edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.2dp"
                android:color="#33FFFFFF" />
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>

    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">

        <shape android:shape="rectangle">
            <!-- iOS 26 Glass.regular: blur 28, semi-transparent -->
            <solid android:color="#4DFFFFFF" />
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp" />
        </shape>
    </item>
    <!-- top highlight shimmer (reflected light) -->
    <item android:bottom="200dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:endColor="@android:color/transparent" android:startColor="#40FFFFFF" android:type="linear"/>
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp"/>
        </shape>
    </item>
</layer-list>
